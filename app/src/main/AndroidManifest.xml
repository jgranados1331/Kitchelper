<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos para ARCore, Cámara e Internet -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Feature de cámara (Hardware) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <!-- Requerido por SceneView para renderizado 3D -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_kitchelper"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_kitchelper"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kitchelper"
        tools:targetApi="31">

        <!-- Metadato de ARCore con tools:replace para evitar el conflicto -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional"
            tools:replace="android:value" />

        <!-- Tu MainActivity principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kitchelper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>